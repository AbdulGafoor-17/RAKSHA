# RAKSHA Disaster Response Server Environment Configuration

# Server Port
PORT=5000

# OpenRouteService API Key (Get a free key from https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=

# MongoDB Connection URI (Optional: Falls back to high-performance in-memory datastore if not running)
MONGODB_URI=mongodb://localhost:27017/raksha

# JWT Authentication Secret
JWT_SECRET=raksha_secure_jwt_token_secret_2026

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
