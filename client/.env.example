# ── RAKSHA Client — Environment Variables ──────────────────────────────────────
#
# For LOCAL development:
#   Copy this file to .env.local (automatically loaded by Vite, never committed)
#   Leave both values pointing to localhost.
#
# For PRODUCTION (Vercel):
#   Set these in the Vercel dashboard → Project → Settings → Environment Variables
#   Both values should point to your Render backend URL.
#
# ─────────────────────────────────────────────────────────────────────────────

# REST API base URL  (must end with /api)
VITE_API_URL=http://localhost:5000/api

# Socket.io server URL  (no /api suffix — just the root server URL)
VITE_SOCKET_URL=http://localhost:5000
